RAGVANTA_PROVIDER=extractive
RAGVANTA_MODEL=extractive-v1
RAGVANTA_RETRIEVAL=lexical
RAGVANTA_DATA_DIR=.runtime
# Set both provider and model explicitly for a live model.
# RAGVANTA_PROVIDER=gemini
# RAGVANTA_MODEL=your_available_model_id
# RAGVANTA_GEMINI_API_KEY=
# RAGVANTA_PROVIDER=ollama
# RAGVANTA_MODEL=your_installed_model
# RAGVANTA_RETRIEVAL=semantic
# RAGVANTA_API_TOKEN=optional-local-token
# Hosted mode (use individual provisioned accounts; never publish Streamlit):
# RAGVANTA_DEPLOYMENT=hosted
# RAGVANTA_PUBLIC_URL=https://your-service.onrender.com
# RAGVANTA_DAILY_USER_MODEL_CALLS=200
# RAGVANTA_DAILY_GLOBAL_MODEL_CALLS=1000
# RAGVANTA_MAX_COLLECTIONS=10
# RAGVANTA_MAX_USER_TEXT_CHARS=5000000
# RAGVANTA_MAX_EXPERIMENT_RUNS=100
